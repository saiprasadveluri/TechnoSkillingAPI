{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DbConString": "Data Source=.;Initial Catalog=TechnoSkillingDb;User ID=QBDBUser;Password=123456;Trust Server Certificate=true"
  },
  "AppData": {
    "AdminPassword": "MyPassword"
  },
  "Jwt": {
    "Key": "MyJWT@Key_Very_Secret_NotToDiscloseToAnyone",
    "Issuer": "TechnoSkilling"
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": ["Serilog.Sinks.File" ],
    "MinimumLevel": "Warning",
    "WriteTo": [      
      {
        "Name": "File",
        "Args": {
          "path": "Logs/applog-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "ApplicationName": "TechnoskillingAPI"
    }
  }
}
